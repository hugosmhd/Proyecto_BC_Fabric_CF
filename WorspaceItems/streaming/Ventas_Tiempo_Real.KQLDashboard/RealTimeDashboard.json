  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "62b13f87-0adc-4af3-9408-4a2333e6fcbd"
      },
      "text": "['raw-ventas']\r\n| extend\r\n    timestamp_evento = todatetime(timestamp_evento),\r\n    venta_total = cantidad * precio_unitario *\r\n        (1 - todouble(descuento_pct) / 100.0)\r\n| where timestamp_evento > ago(30m)\r\n| summarize ventas = sum(venta_total)\r\n    by bin(timestamp_evento, 1m)\r\n| order by timestamp_evento asc\r\n",
      "id": "e77ba992-0ee2-48a0-852b-bf41544c6439",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "62b13f87-0adc-4af3-9408-4a2333e6fcbd"
      },
      "text": "['raw-ventas']\r\n| extend\r\n    timestamp_evento = todatetime(timestamp_evento),\r\n    venta_total = cantidad * precio_unitario *\r\n        (1 - todouble(descuento_pct) / 100.0)\r\n| where timestamp_evento > ago(30m)\r\n| summarize ventas = sum(venta_total)",
      "id": "57ceece9-02ab-4572-abf3-951138fea4af",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "62b13f87-0adc-4af3-9408-4a2333e6fcbd"
      },
      "text": "['raw-ventas']\r\n| extend\r\n    timestamp_evento = todatetime(timestamp_evento),\r\n    es_anomalia = descuento_pct >= 50\r\n| where timestamp_evento > ago(30m)\r\n| summarize\r\n    anomalias = countif(es_anomalia == true)",
      "id": "1dbb8807-3cb8-48b1-8208-bb27be419801",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "62b13f87-0adc-4af3-9408-4a2333e6fcbd"
      },
      "text": "['raw-ventas']\r\n| extend\r\n    timestamp_evento = todatetime(timestamp_evento)\r\n| where timestamp_evento > ago(30m)\r\n| summarize\r\n    unidades = sum(cantidad)",
      "id": "ae265fb9-1947-4ac2-a733-d948864a9607",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "62b13f87-0adc-4af3-9408-4a2333e6fcbd"
      },
      "text": "['raw-ventas']\r\n| extend\r\n    timestamp_evento = todatetime(timestamp_evento),\r\n    es_anomalia = iff(descuento_pct >= 50, \"Anomalía\", \"Normal\")\r\n| project\r\n    Hora = timestamp_evento,\r\n    Tienda = tienda_id,\r\n    SKU = sku,\r\n    Cantidad = cantidad,\r\n    Descuento = descuento_pct,\r\n    Estado = es_anomalia",
      "id": "9f86e6eb-0368-4ce0-b2ad-0b5ff0960f62",
      "usedVariables": []
    }
